DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to "postgresql" for production, or leave as "sqlite" for development
DB_ENGINE=sqlite

# Only needed when DB_ENGINE=postgresql
DB_NAME=seo_audit_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
